// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ══════════════════════════════════════
//  NextAuth.js v5 Required Tables
// ══════════════════════════════════════

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  locale        String    @default("zh-TW")
  timezone      String    @default("Asia/Taipei")
  accounts      Account[]
  sessions      Session[]
  ledgers       Ledger[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ══════════════════════════════════════
//  Core Accounting Models (Double-Entry)
// ══════════════════════════════════════

/// 帳本 — 一個使用者可擁有多個帳本（如「個人」、「家庭」）
model Ledger {
  id              String             @id @default(cuid())
  name            String
  baseCurrency    String             @default("TWD")
  fiscalYearStart Int                @default(1)   // 財政年度起始月 (1=一月)
  monthStartDay   Int                @default(1)   // 每月結算起始日 (支援發薪日起算)
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  finAccounts     FinancialAccount[]
  transactions    Transaction[]
  budgets         Budget[]
  categories      Category[]
  templates       TransactionTemplate[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

/// 財務帳戶 — 資產、負債、收入、支出、權益
model FinancialAccount {
  id             String          @id @default(cuid())
  name           String
  type           AccountType
  icon           String?
  currency       String          @default("TWD")
  openingBalance Decimal         @default(0) @db.Decimal(20, 2)
  isArchived     Boolean         @default(false)
  sortOrder      Int             @default(0)
  ledgerId       String
  ledger         Ledger          @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  postings       Posting[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([ledgerId, type])
}

enum AccountType {
  ASSET      // 資產：現金、銀行存款
  LIABILITY  // 負債：信用卡、貸款
  INCOME     // 收入：薪資、利息
  EXPENSE    // 支出：餐飲、交通
  EQUITY     // 權益：初始資本
}

/// 交易 — 每一筆財務「事件」，底層由多個 Posting 組成
model Transaction {
  id          String    @id @default(cuid())
  date        DateTime
  description String
  memo        String?
  payee       String?
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  isRecurring Boolean   @default(false)
  tags        String[]
  receiptUrl  String?   // OCR 收據圖片 URL (MinIO)
  ledgerId    String
  ledger      Ledger    @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  postings    Posting[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([ledgerId, date])
}

/// Posting — 複式簿記分錄。正值=借方，負值=貸方。每筆 Transaction 的 Postings 總和必須為 0
model Posting {
  id            String           @id @default(cuid())
  amount        Decimal          @db.Decimal(20, 2)
  currency      String           @default("TWD")
  exchangeRate  Decimal?         @db.Decimal(20, 6)
  accountId     String
  account       FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  transactionId String
  transaction   Transaction      @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([transactionId])
}

/// 分類 — 支援父子層級結構（例：餐飲 > 早餐）
model Category {
  id           String        @id @default(cuid())
  nameKey      String        // i18n 翻譯 key (e.g. "category.food")
  icon         String?
  color        String?       // HEX 色碼
  parentId     String?
  parent       Category?     @relation("SubCategories", fields: [parentId], references: [id])
  children     Category[]    @relation("SubCategories")
  ledgerId     String
  ledger       Ledger        @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([ledgerId])
}

/// 預算設定 — 每個分類的月/年預算
model Budget {
  id         String   @id @default(cuid())
  categoryId String
  amount     Decimal  @db.Decimal(20, 2)
  period     String   @default("monthly") // monthly | yearly
  ledgerId   String
  ledger     Ledger   @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([ledgerId, categoryId, period])
}

/// 快速入帳範本 — 一鍵記錄常用支出
model TransactionTemplate {
  id            String   @id @default(cuid())
  name          String
  description   String?
  amount        Decimal  @db.Decimal(20, 2)
  fromAccountId String   // 來源帳戶 (如：現金)
  toAccountId   String   // 目標帳戶 (如：餐飲費)
  categoryId    String?
  ledgerId      String
  ledger        Ledger   @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
}
